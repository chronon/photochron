// vim: set ft=jsonc:
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-web",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "limits": {
    "cpu_ms": 1000,
    "subrequests": 10
  },
  "routes": []
}
