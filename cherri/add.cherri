#include 'actions/web'
#include 'actions/documents'
#include 'actions/images'
#include 'actions/calendar'
#include 'actions/sharing'
#include 'actions/text'
#define color teal
#define from sharesheet
#define inputs image
#define noinput stopwith "Share a photo to add it to Photochron."

#include 'version.cherri'
#include 'config.cherri'

const photoCount = count(ShortcutInput)
@uploaded = 0
@skipped = 0
@failures = []

for photo in ShortcutInput {
	@current = photo
	const name = getImageDetail(@current, "Name")
	@taken = getImageDetail(@current, "Date Taken")
	if !@taken {
		@taken = getImageDetail(@current, "Creation Date")
	}
	const captured = rawAction("is.workflow.actions.format.date", {
		"WFDate": "{@taken}",
		"WFDateFormatStyle": "ISO 8601",
		"WFISO8601IncludeTime": true
	})
	const takenText = rawAction("is.workflow.actions.format.date", {
		"WFDate": "{@taken}",
		"WFDateFormatStyle": "Medium",
		"WFTimeFormatStyle": "Short"
	})

	@progress = ""
	if photoCount > 1 {
		@progress = " ({RepeatIndex} of {photoCount})"
		show(@current)
	}

	@upload = true
	const encodedName = urlEncode(name)
	const lookupResponse = downloadURL("{@domain}/admin/api/images/by-name/{encodedName}", {
		"CF-Access-Client-Id": "{clientId}",
		"CF-Access-Client-Secret": "{clientSecret}",
		"Origin": "{@domain}"
	})
	const existing = getDictionary(lookupResponse)
	const existingId = getValue(existing, "id")
	if existingId {
		const existingUploadedText = getValue(existing, "uploaded")
		const existingUploaded = formatDate("{existingUploadedText}", "Medium")
		menu "{name}{@progress} was already uploaded {existingUploaded}." {
			item "Skip":
				@upload = false
				@skipped += 1
			item "Upload again":
				nothing()
		}
	}

	if @upload == true {
		const caption = prompt("Caption for the photo taken {takenText}{@progress}?", nil, nil, false)

		@metadata = {
			"name": "{name}",
			"caption": "{caption}",
			"captured": "{captured}"
		}

		const response = formRequest("{@domain}/admin/api/images", "POST", {
			"file": @current,
			"metadata": "{@metadata}"
		}, {
			"CF-Access-Client-Id": "{clientId}",
			"CF-Access-Client-Secret": "{clientSecret}",
			"Origin": "{@domain}"
		})
		const result = getDictionary(response)
		const success = getValue(result, "success")
		const error = getValue(result, "error")

		if error {
			@failures += "{name}: {error}"
		} else {
			if success {
				@uploaded += 1
			} else {
				confirm("{@uploaded} uploaded so far. Photochron rejected {name} or isn't responding. If you were sent a new setup code, clear the saved setup so you can paste it?", "Photochron Add ({version})")
				const savedConfig = getFile("photochron.json", nil, false)
				deleteFiles(savedConfig, true)
				alert("Setup cleared. Copy your new setup code, then share the photo again.", "Photochron Add ({version})")
				stop()
			}
		}
	}
}

@summary = "Added {@uploaded}."
if @skipped > 0 {
	@summary = "Added {@uploaded}, skipped {@skipped}."
}

const failureCount = count(@failures)
if failureCount == 0 {
	showNotification("{@summary}", "Photochron Add ({version})", false)
} else {
	const failureList = joinText(@failures)
	alert("{@summary} Failed:\n{failureList}", "Photochron Add ({version})")
}
