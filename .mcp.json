{
  "mcpServers": {
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_MCP_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": ["--isolated"]
    }
  }
}
