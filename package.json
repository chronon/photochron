{
  "name": "photochron",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "vite build && wrangler dev --local",
    "build": "vite build",
    "preview": "wrangler dev --local",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:all": "pnpm check && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest --run",
    "config:build": "tsx scripts/build-config.ts",
    "config:deploy": "pnpm config:build && tsx scripts/deploy-kv.ts",
    "deploy": "pnpm config:build && pnpm config:deploy && pnpm build && wrangler deploy",
    "deploy:preview": "pnpm config:build && pnpm config:deploy && pnpm build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
