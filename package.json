{
  "name": "photochron",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "vite build && wrangler dev --local",
    "build": "vite build",
    "preview": "wrangler dev --local",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:all": "pnpm check && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest --run",
    "config:build": "tsx scripts/build-config.ts",
    "config:deploy": "pnpm config:build && tsx scripts/deploy-kv.ts",
    "deploy": "pnpm config:build && pnpm config:deploy && pnpm build && wrangler deploy",
    "deploy:preview": "pnpm config:build && pnpm config:deploy && pnpm build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0",
    "wrangler": "^4.120.0"
  }
}
